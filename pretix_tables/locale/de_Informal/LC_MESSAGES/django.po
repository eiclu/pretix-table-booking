msgstr ""
"{table}: Dieser Raum wird paarweise verkauft, daher können nur ganze Paare (1-2, 3-4, …) aus dem Verkauf "
"genommen werden."

#: pretix_tables/views.py:265
msgid "Your changes have been saved."
msgstr "Deine Änderungen wurden gespeichert."

