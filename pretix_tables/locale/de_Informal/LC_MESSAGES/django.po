#: pretix_tables/views.py:287
#, python-brace-format
msgid "{table}: “not for sale” must list seat numbers between 1 and {size}, for example “3-4, 9”."
msgstr "{table}: „Nicht im Verkauf“ muss Sitzplatznummern zwischen 1 und {size} enthalten, zum Beispiel „3-4, 9“."

#: pretix_tables/views.py:290
#, python-brace-format
