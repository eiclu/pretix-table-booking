#: pretix_tables/forms.py:13
msgid "Word for a seat"
msgstr "Wort für einen Sitzplatz"

#: pretix_tables/forms.py:14
msgid "Word for several seats"
msgstr "Wort für mehrere Sitzplätze"

#: pretix_tables/forms.py:15
msgid "Word for a table"
msgstr "Wort für einen Tisch"

#: pretix_tables/forms.py:16
msgid "Word for several tables"
msgstr "Wort für mehrere Tische"

#: pretix_tables/forms.py:27
msgid "Name of the checkout step"
msgstr "Name des Bestellschritts"

#: pretix_tables/forms.py:28
msgid "Shown in the progress bar of the checkout. Default: “Reserve seats”."
msgstr "Wird in der Fortschrittsleiste des Bestellvorgangs angezeigt. Standard: „Sitzplätze reservieren“."

#: pretix_tables/forms.py:32
msgid "Introduction of the checkout step"
msgstr "Einleitung des Bestellschritts"

#: pretix_tables/forms.py:33
msgid ""
"Shown above the list of rooms. Default: “You can also reserve seats with your order. This is optional: make"
" your selection or just continue.”"
msgstr ""
"Wird über der Liste der Räume angezeigt. Standard: „Du kannst mit deiner Bestellung auch Sitzplätze "
"reservieren. Das ist optional: Triff deine Auswahl oder fahre einfach fort.“"

#: pretix_tables/forms.py:37
msgid "For example “place”. Default: “seat”."
msgstr "Zum Beispiel „Platz“. Standard: „Sitzplatz“."

#: pretix_tables/forms.py:38
msgid "For example “places”. Default: “seats”."
msgstr "Zum Beispiel „Plätze“. Standard: „Sitzplätze“."

#: pretix_tables/forms.py:39
msgid "For example “box”. Default: “table”."
msgstr "Zum Beispiel „Loge“. Standard: „Tisch“."

#: pretix_tables/forms.py:40
msgid "For example “boxes”. Default: “tables”."
msgstr "Zum Beispiel „Logen“. Standard: „Tische“."

#: pretix_tables/forms.py:44
msgid "Room with numbered tables"
msgstr "Raum mit nummerierten Tischen"

#: pretix_tables/forms.py:47
msgid "Sell this product as a room with numbered tables"
msgstr "Dieses Produkt als Raum mit nummerierten Tischen verkaufen"

#: pretix_tables/forms.py:48
msgid ""
"The product's price is the price per seat. Buyers pick a table and then their seats in a popup. The plugin "
"creates and maintains a quota with the matching size."
msgstr ""
"Der Preis des Produkts ist der Preis pro Sitzplatz. Käufer*innen wählen einen Tisch und anschließend ihre "
"Sitzplätze in einem Popup. Das Plugin erstellt und pflegt ein Kontingent in der passenden Größe."

#: pretix_tables/forms.py:53
msgid "Sell in pairs only"
msgstr "Nur paarweise verkaufen"

#: pretix_tables/forms.py:54
msgid ""
"Seats 1+2, 3+4, 5+6, … of a table can only be bought together, so no single seat is left between two "
"bookings. Requires an even number of seats at every table."
msgstr ""
"Die Sitzplätze 1+2, 3+4, 5+6, … eines Tisches können nur gemeinsam gekauft werden, damit zwischen zwei "
"Buchungen kein einzelner Sitzplatz frei bleibt. Erfordert eine gerade Anzahl an Sitzplätzen an jedem Tisch."

#: pretix_tables/forms.py:59
msgid "Room map"
msgstr "Raumplan"

#: pretix_tables/forms.py:60
msgid "Shown next to the list of tables in the shop."
msgstr "Wird im Shop neben der Liste der Tische angezeigt."

#: pretix_tables/forms.py:63
msgid "Number of tables"
msgstr "Anzahl der Tische"

#: pretix_tables/forms.py:64
msgid "Seats per table"
msgstr "Sitzplätze pro Tisch"

#: pretix_tables/forms.py:65
msgid "Only for this room. Leave empty to use the wording of the event."
msgstr "Nur für diesen Raum. Leer lassen, um die Begriffe der Veranstaltung zu verwenden."

#: pretix_tables/forms.py:89
#, python-brace-format
msgid "This room has {tables} tables with {spaces} seats."
msgstr "Dieser Raum hat {tables} Tische mit insgesamt {spaces} Sitzplätzen."

#: pretix_tables/forms.py:94 pretix_tables/templates/pretix_tables/control_overview.html:52
msgid "Manage tables"
msgstr "Tische verwalten"

#: pretix_tables/forms.py:97
msgid "Created as “Table 1”, “Table 2”, … You can rename, add and remove tables afterwards."
msgstr ""
"Werden als „Tisch 1“, „Tisch 2“, … angelegt. Du kannst Tische anschließend umbenennen, hinzufügen und "
"entfernen."

#: pretix_tables/forms.py:102
msgid "Rooms with numbered tables are not available for event series."
msgstr "Räume mit nummerierten Tischen sind für Veranstaltungsreihen nicht verfügbar."

#: pretix_tables/forms.py:104
msgid "Rooms with numbered tables can not be combined with a seating plan."
msgstr "Räume mit nummerierten Tischen können nicht mit einem Sitzplan kombiniert werden."

#: pretix_tables/forms.py:106
msgid "Rooms with numbered tables can not have variations. Use one product per room."
msgstr "Räume mit nummerierten Tischen können keine Varianten haben. Verwende ein Produkt pro Raum."

#: pretix_tables/forms.py:120
#, python-brace-format
msgid "These tables have an odd number of seats: {tables}"
msgstr "Diese Tische haben eine ungerade Anzahl an Sitzplätzen: {tables}"

#: pretix_tables/forms.py:125
msgid "This field is required."
msgstr "Dieses Feld ist erforderlich."

#: pretix_tables/forms.py:127 pretix_tables/views.py:257
msgid "Pairs need an even number of seats."
msgstr "Für den paarweisen Verkauf ist eine gerade Anzahl an Sitzplätzen nötig."

#: pretix_tables/services.py:73
#, python-brace-format
msgid "{name} (numbered seats)"
msgstr "{name} (nummerierte Sitzplätze)"

#: pretix_tables/services.py:185
#, python-brace-format
msgid ""
"{room_name}, {table_name}: {spaces} are only sold in pairs. Please add {space} {missing} as well or remove "
"{space} {number} from your cart."
msgstr ""
"{room_name}, {table_name}: {spaces} werden nur paarweise verkauft. Bitte füge auch {space} {missing} hinzu "
"oder entferne {space} {number} aus deinem Warenkorb."

#: pretix_tables/signals.py:50 pretix_tables/templates/pretix_tables/control_overview.html:3
#: pretix_tables/templates/pretix_tables/control_overview.html:5
msgid "Rooms and tables"
msgstr "Räume und Tische"

