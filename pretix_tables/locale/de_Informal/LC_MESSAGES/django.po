msgid "%(tables)s tables, %(size)s seats: %(free)s free, %(held)s in carts, %(sold)s sold."
msgstr "%(tables)s Tische, %(size)s Sitzplätze: %(free)s frei, %(held)s in Warenkörben, %(sold)s verkauft."

#: pretix_tables/templates/pretix_tables/control_tables.html:17
#, python-format
msgid "%(n)s more are not for sale."
msgstr "%(n)s weitere sind nicht im Verkauf."

#: pretix_tables/templates/pretix_tables/control_tables.html:18
msgid "Seats are sold in pairs."
msgstr "Sitzplätze werden paarweise verkauft."

#: pretix_tables/templates/pretix_tables/control_tables.html:21
msgid ""
"Use “Not for sale” for seats that do not exist at a table or that you give out yourself, for example “3-4, "
"9”. They keep their number, are shown as not available in the shop and do not count towards the quota. You "
"can still assign them to an order by hand in the backend."
msgstr ""
"Verwende „Nicht im Verkauf“ für Sitzplätze, die es an einem Tisch nicht gibt oder die du selbst vergibst, "
"zum Beispiel „3-4, 9“. Diese Sitzplätze behalten ihre Nummer, werden im Shop als nicht verfügbar angezeigt "
"und zählen nicht zum Kontingent. Im Backend kannst du sie weiterhin von Hand einer Bestellung zuweisen."

