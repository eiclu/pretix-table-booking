#: pretix_tables/apps.py:13
msgid "Numbered seats"
msgstr "Nummerierte Sitzplätze"

#: pretix_tables/apps.py:16
msgid "Sell products and variations as numbered seats, e.g. at a table. Buyers pick their seats in a popup."
msgstr ""
"Produkte und Varianten als nummerierte Sitzplätze verkaufen, z. B. an einem Tisch. Käufer*innen wählen ihre"
" Sitzplätze in einem Popup aus."

#: pretix_tables/checkoutflow.py:97
msgid "We were not able to process your request completely as the server was too busy. Please try again."
msgstr ""
"Wir konnten deine Anfrage nicht vollständig bearbeiten, da der Server zu beschäftigt war. Bitte versuche es"
" erneut."

#: pretix_tables/exporters.py:10
msgid "Table reservations"
msgstr "Tischreservierungen"

#: pretix_tables/exporters.py:11
msgctxt "export_category"
msgid "Order data"
msgstr "Bestelldaten"

#: pretix_tables/exporters.py:12
msgid "Download a list with one row per reserved seat: room, table, seat, order and name."
msgstr "Liste mit einer Zeile pro reserviertem Sitzplatz herunterladen: Raum, Tisch, Sitzplatz, Bestellung und Name."

